# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Independent secret used to sign administrative sessions
ADMIN_SESSION_SECRET=

# External webhook verification
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
CRON_SECRET=
INTERNAL_FUNCTION_SECRET=

# Deployment configuration (Vercel)
NITRO_PRESET=vercel

# Optional external providers (server-only)
OPENAI_API_KEY=

NAVOR_TENANT_SECRETS_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ESCAVADOR_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# PAGAMENTO — NUNCA usar em variáveis VITE_*, banco público ou logs
# ──────────────────────────────────────────────────────────────────────────────

# Provedor de pagamento ativo: 'disabled' (padrão seguro) ou 'asaas'
NAVOR_BILLING_PROVIDER=disabled

# Asaas — chave de API (apenas servidor, NUNCA no frontend)
ASAAS_API_KEY=
ASAAS_API_KEY_SANDBOX=
ASAAS_WEBHOOK_TOKEN=
# Ambiente do Asaas: 'sandbox' (padrão) ou 'production'
ASAAS_ENVIRONMENT=sandbox

# ──────────────────────────────────────────────────────────────────────────────
# E-MAIL TRANSACIONAL — NUNCA usar em variáveis VITE_* ou logs
# ──────────────────────────────────────────────────────────────────────────────

# Provedor de e-mail ativo: 'dev' (padrão seguro — apenas loga) ou 'resend'
NAVOR_EMAIL_PROVIDER=dev

# Resend — chave de API (apenas servidor, NUNCA no frontend)
RESEND_API_KEY=
# E-mail remetente padrão
RESEND_FROM_EMAIL=no-reply@navorbr.com

# ──────────────────────────────────────────────────────────────────────────────
# COFRE DE SEGREDOS DE TENANT (já existente)
# ──────────────────────────────────────────────────────────────────────────────
NAVOR_TENANT_SECRETS_KEY=
